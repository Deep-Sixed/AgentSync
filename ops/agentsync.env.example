# AgentSync MCP service runtime configuration
# Copy to: ~/.config/agentsync/env
# Never commit the live env file.

# Transport
AGENTSYNC_TRANSPORT=http
AGENTSYNC_PORT=8585

# Logging (journald via systemd SyslogIdentifier=agentsync-mcp)
AGENTSYNC_LOG_LEVEL=INFO

# Mutable storage (defaults match repo layout under storage/)
AGENTSYNC_RULES_PATH=/mnt/jarvis-data/projects/AgentSync/storage/rules/rules.yaml
AGENTSYNC_CAPABILITIES_PATH=/mnt/jarvis-data/projects/AgentSync/storage/rules/capabilities.yaml
AGENTSYNC_PRE_OBLIGATIONS_PATH=/mnt/jarvis-data/projects/AgentSync/storage/obligations/pre_obligations.jsonl
AGENTSYNC_APPROVED_ROOT=/mnt/jarvis-data/projects/AgentSync/storage/skills/approved
AGENTSYNC_OBLIGATIONS_PATH=/mnt/jarvis-data/projects/AgentSync/storage/obligations/obligations.jsonl
AGENTSYNC_STELE_DB_PATH=/mnt/jarvis-data/projects/AgentSync/storage/stele/ledger.db
AGENTSYNC_ARTIFACTS_BASE=/mnt/jarvis-data/projects/AgentSync/storage/stele/artifacts

# ContextForge agent auth (for smoke tests / MCP clients — not read by AgentSync server)
# ROUTERCORE_MCP_BEARER_TOKEN=
